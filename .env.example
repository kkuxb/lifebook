# 人生簿（Lifebook）环境变量示例文件
# 复制为 .env 后再修改口令与密钥，请勿将真实 .env 提交或打包

# 服务端监听端口（绿联默认 3220，避开时间簿 3210）
PORT=3220

# 数据持久化目录（容器内固定挂载 /data）
DATA_DIR=./workspace-data/lifebook

# 单人访问口令（留空将拒绝生产登录或仅在显式配置后启用）
APP_PASSWORD=change_me_to_your_password

# 本地 AES-256-GCM 加密主密钥（留空时服务端将在 DATA_DIR/.master.key 自动生成并持久化随机密钥）
APP_SECRET=

# 默认时区（严格用于自然日快照清理与月/年锁判定）
TZ=Asia/Shanghai
